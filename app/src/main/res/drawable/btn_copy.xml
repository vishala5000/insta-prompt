<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:type="linear"
                android:startColor="#FF5A68" android:centerColor="#E01F33" android:endColor="#7A0C1C" />
            <stroke android:width="2dp" android:color="#66FF8A94" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
